# Source-only repository. Local workspaces and large dependency trees stay local.
/*
!/.gitignore
!/README.md
!/README.RU.MD
!/AGENTS.md
!/TOOLS.MD
!/TASK-SQL.MD
!/PLAN_GUI.MD
!/report-fps.md
!/RELEASE_NOTES_1.1.md
!/SKILL/
!/perf/
/perf/*
!/perf/baseline.md
!/ABOUT_DE-AC5.MD
!/LICENSE
!/tools/
!/scripts/
!/docs/
/tools/**
!/tools/**/
!/tools/**/*.py
!/tools/**/*.sh
!/tools/**/*.bash
!/tools/**/*.mjs
!/tools/**/*.js
!/tools/**/*.ts
!/tools/**/*.md
!/tools/**/*.MD
!/tools/**/*.cpp
!/tools/**/*.cc
!/tools/**/*.c
!/tools/**/*.h
!/tools/**/*.hpp
!/tools/**/*.cs
!/tools/**/*.java
!/tools/**/*.toml
!/tools/**/*.cmake
!/tools/**/*.txt
!/tools/**/*.in
!/tools/**/*.json
!/tools/**/*.yaml
!/tools/**/*.yml
!/tools/**/*.sql
!/tools/**/*.patch
!/tools/**/*.csproj
!/tools/**/*.lock
!/tools/**/*.example
!/tools/**/CMakeLists.txt
!/tools/**/LICENSE
!/tools/**/LICENSE.*
!/tools/**/NOTICE
/scripts/**
!/scripts/**/
!/scripts/**/*.sh
!/scripts/**/*.py
/docs/**
!/docs/**/
!/docs/**/*.md
!/docs/**/*.MD

# External checkouts and their build products are acquired separately.
/tools/rexglue-sdk/
/tools/XenonRecomp/
/tools/XenosRecomp/
/tools/Armored-core-ReAnswered/
/tools/trg-launcher/
