/tools/c-xbox_tool_2.0.7/
/tools/xenonrecomp-bin/
/tools/ghidra-rpc-local/
# docs/fine: published Markdown and JSON reports; archives stay local (*.gz above).
!/docs/fine/
!/docs/fine/**/*.md
!/docs/fine/**/*.json

