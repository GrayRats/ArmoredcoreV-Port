+void CommandProcessor::CallInThreadForReadback(std::function<void()> fn) {
+  if (system::XThread::IsInThread(worker_thread_.get())) {
+    fn();
+    return;
+  }
+  {
+    std::lock_guard<std::mutex> lock(pending_fns_mutex_);
+    readback_fns_.push(std::move(fn));
+  }
+  write_ptr_index_event_->Set();
+}
+
+void CommandProcessor::ExecuteReadbackFunctions() {
+  for (;;) {
+    std::function<void()> fn;
+    {
+      std::lock_guard<std::mutex> lock(pending_fns_mutex_);
+      if (readback_fns_.empty()) return;
+      fn = std::move(readback_fns_.front());
+      readback_fns_.pop();
+    }
+    fn();
+  }
+}
