+bool VulkanCommandProcessor::AwaitReadbackSubmission(uint64_t submission) {
+  if (!submission || device_lost_) {
+    return false;
+  }
+  CheckSubmissionFenceAndDeviceLoss(submission);
+  // EndSubmission or a fence wait may fail without reporting device loss.
+  // Check the requested ticket rather than treating a non-lost device as ready.
+  return !device_lost_ && submission_completed_ >= submission;
+}
