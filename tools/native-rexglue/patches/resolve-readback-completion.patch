+VulkanCommandProcessor::ReadbackBuffer*
+VulkanCommandProcessor::GetOrCreateMemexportReadbackBuffer(uint32_t total_size) {
+  if (!total_size || memexport_ranges_.empty() || !ValidateMemexportReadbackRanges(total_size)) {
+    return nullptr;
+  }
+  // Resolve the compact key against the full ordered range topology. A key
+  // collision or equal first-base/size pair must never reuse differently
+  // packed bytes.
+  const uint64_t first_key =
+      MakeMemexportReadbackKey(memexport_ranges_.front().base_address_dwords, total_size);
+  uint64_t readback_key = first_key;
+  auto layout_matches = [&](const ReadbackBuffer& candidate) {
+    if (candidate.memexport_range_layout.size() != memexport_ranges_.size()) {
+      return false;
+    }
+    for (size_t i = 0; i < memexport_ranges_.size(); ++i) {
+      if (candidate.memexport_range_layout[i].first != memexport_ranges_[i].base_address_dwords ||
+          candidate.memexport_range_layout[i].second != memexport_ranges_[i].size_bytes) {
+        return false;
+      }
+    }
+    return true;
+  };
+  auto readback_it = memexport_readback_buffers_.find(readback_key);
+  while (readback_it != memexport_readback_buffers_.end() && !layout_matches(readback_it->second)) {
+    ++readback_key;
+    if (readback_key == first_key) {
+      REXGPU_ERROR("No free MEMEXPORT readback key for the current range layout");
+      return nullptr;
+    }
+    readback_it = memexport_readback_buffers_.find(readback_key);
+  }
+  if (readback_it == memexport_readback_buffers_.end()) {
+    readback_it = memexport_readback_buffers_.try_emplace(readback_key).first;
+  }
+  ReadbackBuffer& readback = readback_it->second;
+  if (readback.memexport_range_layout.empty()) {
+    readback.memexport_range_layout.reserve(memexport_ranges_.size());
+    for (const draw_util::MemExportRange& memexport_range : memexport_ranges_) {
+      readback.memexport_range_layout.emplace_back(memexport_range.base_address_dwords,
+                                                   memexport_range.size_bytes);
+    }
+  }
+  return &readback;
+}
