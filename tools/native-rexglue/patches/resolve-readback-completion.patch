+bool VulkanCommandProcessor::ValidateMemexportReadbackRanges(uint32_t total_size) const {
+  uint64_t packed_size = 0;
+  for (const draw_util::MemExportRange& memexport_range : memexport_ranges_) {
+    const uint64_t offset = uint64_t(memexport_range.base_address_dwords) << 2;
+    const uint64_t size = memexport_range.size_bytes;
+    if (!size || offset > SharedMemory::kBufferSize ||
+        size > uint64_t(SharedMemory::kBufferSize) - offset) {
+      REXGPU_ERROR("MEMEXPORT range is outside physical memory: {:08X} + {}",
+                   memexport_range.base_address_dwords << 2, memexport_range.size_bytes);
+      return false;
+    }
+    packed_size += size;
+    if (packed_size > UINT32_MAX) {
+      REXGPU_ERROR("MEMEXPORT packed readback exceeds the supported size");
+      return false;
+    }
+  }
+  if (packed_size != total_size) {
+    REXGPU_ERROR("MEMEXPORT packed size mismatch: expected {}, ranges total {}", total_size,
+                 packed_size);
+    return false;
+  }
+  return true;
+}
