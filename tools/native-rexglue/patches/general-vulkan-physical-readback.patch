+bool VulkanCommandProcessor::PrepareGeneralResolveDestination(uint32_t address, uint32_t length) {
+  if (!general_readback_ || !general_readback_->scope) return true;
+  auto& context = *general_readback_;
+  if (!context.prepared || context.prepared->range.address != address ||
+      context.prepared->range.bytes != length || !context.scope->WaitForCpuAccess()) return false;
+  // Uploading can await old providers and temporarily unlock memory. Finish any
+  // host IO admitted during that wait, then refresh invalidated destination pages
+  // before allocating descriptors or arming this generation's provider.
+  return shared_memory_->RequestRange(address, length) && context.scope->WaitForCpuAccess() &&
+      shared_memory_->RequestRange(address, length) && context.scope->ValidateLocked() &&
+      BeginSubmission(true);
+}
+
+bool VulkanCommandProcessor::RegisterGeneralResolveWrite(uint32_t address, uint32_t length) {
+  if (!general_readback_ || !general_readback_->scope) return true;
+  auto& context = *general_readback_;
+  if (!context.prepared || context.prepared->range.address != address ||
+      context.prepared->range.bytes != length || !context.scope->ValidateLocked() ||
+      !context.bridge.RegisterLocked(context.scope->lock(), context.prepared) ||
+      !context.scope->ValidateLocked()) return false;
+  // Registration supplies the bytes; alias watches intercept guest CPU access.
+  // Both must be installed under the same memory lock before recording writes.
+  memory_->EnablePhysicalMemoryAccessCallbacks(address, length, true, true);
+  return true;
+}
