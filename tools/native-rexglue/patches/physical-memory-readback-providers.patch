+bool Memory::RegisterExplicitPhysicalReadback(PhysicalReadbackProvider provider) {
+  auto lock = global_critical_region_.Acquire();
+  if (!provider.range.valid()) return false;
+  if (physical_membase_) {
+    // GPU publication bypasses guest protection through the private physical
+    // mapping. A guest read-only Protect also affects that parent mapping;
+    // restore its writable bypass before queuing a provider. Guest aliases
+    // retain their own protections. Unallocated/inaccessible ranges are rejected.
+    const auto& range = provider.range;
+    if (heaps_.physical.QueryRangeAccess(range.address, range.address + range.bytes - 1) ==
+        rex::memory::PageAccess::kNoAccess) return false;
+    const uint32_t start = range.address & ~(system_page_size_ - 1);
+    const uint64_t end = (uint64_t(range.address) + range.bytes + system_page_size_ - 1) &
+                         ~uint64_t(system_page_size_ - 1);
+    if (!rex::memory::Protect(TranslatePhysical(start), size_t(end - start),
+                             rex::memory::PageAccess::kReadWrite)) return false;
+  }
+  if (physical_mutation_generations_.empty()) physical_mutation_generations_.resize(0x20000);
+  return explicit_physical_readbacks_.Register(std::move(provider));
+}
+
+bool Memory::BeginPhysicalReadbackMutation(std::unique_lock<std::recursive_mutex>& lock,
+                                          uint32_t physical_address, uint32_t length) {
+  if (physical_mutation_generations_.empty()) return true;
+  if (!detail::PhysicalReadbackProviders::Range{physical_address, length}.valid()) return false;
+  const uint32_t first = physical_address >> 12;
+  const uint32_t end = uint32_t((uint64_t(physical_address) + length + 4095) >> 12);
+  const auto begin = physical_mutation_generations_.begin() + first;
+  const std::vector<uint64_t> snapshot(begin, physical_mutation_generations_.begin() + end);
+  if (!SynchronizeExplicitPhysicalReadback(lock, physical_address, length)) return false;
+  // Another allocator may have released/reused this exact address while the
+  // completion wait released the global lock. Never mutate its new owner.
+  if (!std::equal(snapshot.begin(), snapshot.end(), begin)) return false;
+  RecordPhysicalReadbackMutation(physical_address, length);
+  return true;
+}
+
+void Memory::RecordPhysicalReadbackMutation(uint32_t physical_address, uint32_t length) {
+  if (physical_mutation_generations_.empty()) return;
+  if (!detail::PhysicalReadbackProviders::Range{physical_address, length}.valid()) {
+    rex::FatalError("Invalid physical allocator mutation range");
+  }
+  const uint32_t first = physical_address >> 12;
+  const uint32_t end = uint32_t((uint64_t(physical_address) + length + 4095) >> 12);
+  for (uint32_t i = first; i < end; ++i) {
+    if (physical_mutation_generations_[i] == UINT64_MAX) {
+      rex::FatalError("Physical allocation generation exhausted");
+    }
+    ++physical_mutation_generations_[i];
+  }
+}
