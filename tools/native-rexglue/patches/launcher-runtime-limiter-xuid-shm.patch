diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index a744375..726f457 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -12,6 +12,7 @@
 #include <algorithm>
 #include <cinttypes>
 #include <cmath>
+#include <chrono>
 #include <cstring>
 #include <string_view>
 
@@ -37,6 +38,12 @@
 
 REXCVAR_DEFINE_BOOL(vsync, true, "GPU", "Enable vertical sync");
 
+REXCVAR_DEFINE_INT32(frame_limit_fps, 0, "GPU",
+                     "Cap presented guest frames per second by pacing swaps (0 = off). "
+                     "Paces the swap only; guest timestep is not changed.")
+    .range(0, 1000)
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
 REXCVAR_DEFINE_BOOL(clear_memory_page_state, true, "GPU",
                     "Refresh page-valid state from GPU-written memory at frame end. "
                     "Disable for minor CPU overhead reduction, but may break memory coherency.")
@@ -958,6 +965,20 @@ bool CommandProcessor::ExecutePacketType3_XE_SWAP(memory::RingBuffer* reader, ui
   uint32_t frontbuffer_height = reader->ReadAndSwap<uint32_t>();
   reader->AdvanceRead((count - 4) * sizeof(uint32_t));
 
+  if (const int32_t limit = REXCVAR_GET(frame_limit_fps); limit > 0) {
+    // Absolute-deadline pacing: sleeping to a schedule (not for a fixed delay) keeps the average
+    // rate exact. After a long stall the schedule restarts instead of bursting to catch up.
+    static std::chrono::steady_clock::time_point next_swap;
+    const auto period = std::chrono::nanoseconds(1000000000LL / limit);
+    const auto now = std::chrono::steady_clock::now();
+    if (next_swap < now - period) {
+      next_swap = now;
+    } else if (next_swap > now) {
+      rex::thread::Sleep(std::chrono::duration_cast<std::chrono::microseconds>(next_swap - now));
+    }
+    next_swap += period;
+  }
+
   IssueSwap(frontbuffer_ptr, frontbuffer_width, frontbuffer_height);
 
   ++counter_;
