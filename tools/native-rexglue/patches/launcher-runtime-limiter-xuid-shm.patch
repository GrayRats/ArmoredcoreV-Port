 #include <cstring>
 #include <string_view>
 
@@ -37,6 +38,12 @@
 
 REXCVAR_DEFINE_BOOL(vsync, true, "GPU", "Enable vertical sync");
 
+REXCVAR_DEFINE_INT32(frame_limit_fps, 0, "GPU",
+                     "Cap presented guest frames per second by pacing swaps (0 = off). "
+                     "Paces the swap only; guest timestep is not changed.")
+    .range(0, 1000)
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
 REXCVAR_DEFINE_BOOL(clear_memory_page_state, true, "GPU",
                     "Refresh page-valid state from GPU-written memory at frame end. "
                     "Disable for minor CPU overhead reduction, but may break memory coherency.")
@@ -958,6 +965,33 @@ bool CommandProcessor::ExecutePacketType3_XE_SWAP(memory::RingBuffer* reader, ui
   uint32_t frontbuffer_height = reader->ReadAndSwap<uint32_t>();
   reader->AdvanceRead((count - 4) * sizeof(uint32_t));
 
+  const int32_t limit = REXCVAR_GET(frame_limit_fps);
+  const auto now = std::chrono::steady_clock::now();
+  if (limit != previous_frame_limit_ || limit <= 0) next_swap_ = now;
+  previous_frame_limit_ = limit;
+  if (limit > 0) {
+    const auto period = std::chrono::nanoseconds(1000000000LL / limit);
+    if (next_swap_ < now - period) next_swap_ = now;
+    if (next_swap_ > now) {
+      rex::thread::Sleep(std::chrono::duration_cast<std::chrono::microseconds>(next_swap_ - now));
+    }
+    next_swap_ += period;
+  }
+  const auto paced = std::chrono::steady_clock::now();
+  if (previous_swap_.time_since_epoch().count()) {
+    swap_intervals_ms_.push_back(std::chrono::duration<double, std::milli>(paced - previous_swap_).count());
+    if (swap_intervals_ms_.size() == 300) {
+      auto intervals = swap_intervals_ms_;
+      std::sort(intervals.begin(), intervals.end());
+      double total = 0;
+      for (double interval : intervals) total += interval;
+      REXLOG_INFO("[acv-display] pacing samples=300 limit={} fps={} mean_ms={} p95_ms={} p99_ms={} min_ms={} max_ms={}",
+          limit, 300000.0 / total, total / 300.0, intervals[284], intervals[296], intervals.front(), intervals.back());
+      swap_intervals_ms_.clear();
+    }
+  }
+  previous_swap_ = paced;
+
   IssueSwap(frontbuffer_ptr, frontbuffer_width, frontbuffer_height);
 
   ++counter_;
