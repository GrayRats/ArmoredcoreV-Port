+void DeferredCommandBuffer::CmdVkPipelineBarrier2(PFN_vkCmdPipelineBarrier2 command,
+    uint32_t buffer_count,const VkBufferMemoryBarrier2* buffers,
+    uint32_t image_count,const VkImageMemoryBarrier2* images) {
+  static_assert(alignof(VkBufferMemoryBarrier2)<=alignof(uintmax_t));
+  static_assert(alignof(VkImageMemoryBarrier2)<=alignof(uintmax_t));
+  const size_t buffer_offset=rex::align(sizeof(ArgsVkPipelineBarrier2),alignof(VkBufferMemoryBarrier2));
+  const size_t image_offset=rex::align(buffer_offset+sizeof(VkBufferMemoryBarrier2)*buffer_count,alignof(VkImageMemoryBarrier2));
+  auto* bytes=reinterpret_cast<uint8_t*>(WriteCommand(Command::kVkPipelineBarrier2,image_offset+sizeof(VkImageMemoryBarrier2)*image_count));
+  auto& args=*reinterpret_cast<ArgsVkPipelineBarrier2*>(bytes);
+  args.command=command;args.buffer_count=buffer_count;args.image_count=image_count;
+  if(buffer_count)std::memcpy(bytes+buffer_offset,buffers,sizeof(VkBufferMemoryBarrier2)*buffer_count);
+  if(image_count)std::memcpy(bytes+image_offset,images,sizeof(VkImageMemoryBarrier2)*image_count);
