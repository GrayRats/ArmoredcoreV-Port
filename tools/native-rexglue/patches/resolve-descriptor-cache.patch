+bool VulkanCommandProcessor::GetCachedResolveDestinationDescriptor(
+    const VkDescriptorBufferInfo& info, VkDescriptorSet& descriptor) {
+  descriptor = VK_NULL_HANDLE;
+  if (!general_readback_ || !general_readback_->resolve_descriptors) return true;
+  auto& context = *general_readback_;
+  auto& cache = *context.resolve_descriptors;
+  const auto& profile = acv::gpu_profile::configuration();
+  const bool trace = profile.path && *profile.path && profile.age() >= 90;
+  if (trace) cache.EnableStatistics();
+  const auto result = cache.Get(info);
+  if (trace && profile.age() - context.last_descriptor_trace >= 5) {
+    const auto& stats = cache.statistics();
+    REXGPU_INFO("ACV resolve descriptors age={} entries={} lookups={} hits={} updates={} "
+                "allocations={} fallback={} failures={}", profile.age(), cache.size(),
+                stats.lookups, stats.hits, stats.updates, stats.allocations, stats.fallbacks, stats.failures);
+    context.last_descriptor_trace = profile.age();
+  }
+  if (result.status == acv::ResolveDescriptorCache::Status::Ready) {
+    descriptor = result.set; return true;
+  }
+  if (result.status == acv::ResolveDescriptorCache::Status::Full) return true;
+  if (result.status == acv::ResolveDescriptorCache::Status::ApiFailure &&
+      acv::ResolveDescriptorCache::ResourceExhaustion(result.vk_result)) {
+    if (!context.descriptor_resource_warning) {
+      REXGPU_WARN("Resolve descriptor cache allocation unavailable ({}); using transient descriptors",
+                  int(result.vk_result));
+      context.descriptor_resource_warning = true;
+    }
+    return true;
+  }
+  REXGPU_ERROR("Resolve descriptor cache rejected binding or Vulkan call (status={}, VkResult={})",
+               int(result.status), int(result.vk_result));
+  if (result.vk_result == VK_ERROR_DEVICE_LOST && !device_lost_) {
+    device_lost_ = true;
+    if (graphics_system_) graphics_system_->OnHostGpuLossFromAnyThread(true);
+  }
+  return false;
+}
