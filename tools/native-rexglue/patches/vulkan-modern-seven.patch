+bool VulkanCommandProcessor::EnsureTimelineSubmission() {
+  const auto* vulkan_device=GetVulkanDevice();const VkDevice device=vulkan_device->device();
+  if (!timeline_initialized_) {
+    timeline_initialized_=true;
+    if (vulkan_device->properties().timelineSemaphore && submissions_in_flight_fences_.empty()) {
+      VkPhysicalDeviceTimelineSemaphoreProperties limits{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_TIMELINE_SEMAPHORE_PROPERTIES};
+      VkPhysicalDeviceProperties2 props{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2};props.pNext=&limits;
+      const auto& ifn=vulkan_device->vulkan_instance()->functions();
+      ifn.vkGetPhysicalDeviceProperties2(vulkan_device->physical_device(),&props);
+      timeline_submission_=std::make_unique<TimelineContext>(device,ifn.vkGetDeviceProcAddr,submission_completed_,limits.maxTimelineSemaphoreValueDifference);
+      if(timeline_submission_->initialization!=VK_SUCCESS){
+        VkResult result=timeline_submission_->initialization;
+        REXGPU_WARN("Timeline submission initialization failed: {}; retaining fence path",int(result));
+        timeline_submission_.reset();
+        if(result==VK_ERROR_DEVICE_LOST){device_lost_=true;if(graphics_system_)graphics_system_->OnHostGpuLossFromAnyThread(true);return false;}
+      }
+    }
+  }
+  return !device_lost_;
+}
+
+bool VulkanCommandProcessor::AwaitAllQueueOperationsCompletion() {
+  CheckSubmissionFenceAndDeviceLoss(GetCurrentSubmission());
+  if(submission_open_ || !submissions_in_flight_fences_.empty())return false;
+  if(general_readback_ && general_readback_->transfer && !device_lost_){
+    VkResult result=general_readback_->transfer->WaitForTicket(UINT64_MAX);
+    if(result!=VK_SUCCESS){
+      REXGPU_ERROR("Transfer queue completion failed: {}",int(result));
+      if(result==VK_ERROR_DEVICE_LOST){device_lost_=true;if(graphics_system_)graphics_system_->OnHostGpuLossFromAnyThread(true);}
+      return false;
+    }
+  }
+  return !device_lost_;
+}
+
+void VulkanCommandProcessor::AddTransferReadbackDependency(){
+  if(!general_readback_ || !general_readback_->transfer || !general_readback_->transfer->latest())return;
+  auto& transfer=*general_readback_->transfer;
+  for(size_t i=0;i<current_submission_wait_semaphores_.size();++i)if(current_submission_wait_semaphores_[i]==transfer.handle()){
+    current_submission_wait_values_[i]=transfer.latest();return;
+  }
+  current_submission_wait_semaphores_.push_back(transfer.handle());
+  current_submission_wait_values_.push_back(transfer.latest());
+  current_submission_wait_stage_masks_.push_back(VK_PIPELINE_STAGE_ALL_COMMANDS_BIT);
+}
