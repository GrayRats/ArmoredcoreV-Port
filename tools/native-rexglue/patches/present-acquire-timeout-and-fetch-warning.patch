+namespace {
+// Upper bound for vkAcquireNextImageKHR in the paint path (see PaintAndPresentImpl).
+constexpr uint64_t kSwapchainAcquireTimeoutNs = 2000000000ull;
+// Bound for waiting on the previous paint submission before a new paint begins (nothing is acquired yet there,
+// so the frame can simply be skipped).
+constexpr uint64_t kPaintSubmissionTimeoutNs = 2000000000ull;
+// Waits that happen with a swapchain image already acquired stay unbounded, but a wait longer than this is
+// reported once with its location, so a stall shows where it is.
+constexpr uint64_t kStallReportNs = 5000000000ull;
+
+void AwaitReportingStall(VulkanSubmissionTracker& tracker, uint64_t submission_index,
+                         const char* where) {
+  tracker.AwaitSubmissionCompletion(submission_index, kStallReportNs);
+  if (tracker.UpdateAndGetCompletedSubmission() >= submission_index) {
+    return;
+  }
+  static bool reported = false;
+  if (!reported) {
+    reported = true;
+    REXLOG_ERROR(
+        "VulkanPresenter: waiting more than {} s for GPU submission {} ({}); the GPU work has not completed",
+        kStallReportNs / 1000000000ull, submission_index, where);
+  }
+  tracker.AwaitSubmissionCompletion(submission_index);
+}
+
+// Names the Vulkan call the UI thread is inside, so a stall of the window's thread reports where it is. A call
+// such as vkQueuePresentKHR or vkQueueSubmit has no timeout, so it cannot be bounded; the watchdog only reports.
+std::atomic<const char*> g_paint_stage{nullptr};
+std::atomic<int64_t> g_paint_stage_since_ns{0};
+
+int64_t SteadyNowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+void EnsurePaintWatchdog() {
+  static std::once_flag started;
+  std::call_once(started, [] {
+    std::thread([] {
+      int64_t reported_since = 0;
+      for (;;) {
+        std::this_thread::sleep_for(std::chrono::seconds(1));
+        const char* stage = g_paint_stage.load(std::memory_order_acquire);
+        const int64_t since = g_paint_stage_since_ns.load(std::memory_order_acquire);
+        if (stage && since && since != reported_since && SteadyNowNs() - since > 5000000000ll) {
+          reported_since = since;
+          REXLOG_ERROR("VulkanPresenter: the UI thread has been inside {} for more than 5 s", stage);
+        }
+      }
+    }).detach();
+  });
+}
+
+class PaintStage {
+ public:
+  explicit PaintStage(const char* name) {
+    EnsurePaintWatchdog();
+    g_paint_stage_since_ns.store(SteadyNowNs(), std::memory_order_release);
+    g_paint_stage.store(name, std::memory_order_release);
+  }
+  ~PaintStage() { g_paint_stage.store(nullptr, std::memory_order_release); }
+  PaintStage(const PaintStage&) = delete;
+  PaintStage& operator=(const PaintStage&) = delete;
+};
