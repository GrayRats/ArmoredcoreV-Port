+// Upper bound for vkAcquireNextImageKHR in the paint path (see PaintAndPresentImpl).
+constexpr uint64_t kSwapchainAcquireTimeoutNs = 2000000000ull;
+// Bound for waiting on the previous paint submission before a new paint begins (nothing is acquired yet there,
+// so the frame can simply be skipped).
+constexpr uint64_t kPaintSubmissionTimeoutNs = 2000000000ull;
+// Waits that happen with a swapchain image already acquired stay unbounded, but a wait longer than this is
+// reported once with its location, so a stall shows where it is.
+constexpr uint64_t kStallReportNs = 5000000000ull;
+
+void AwaitReportingStall(VulkanSubmissionTracker& tracker, uint64_t submission_index,
+                         const char* where) {
+  tracker.AwaitSubmissionCompletion(submission_index, kStallReportNs);
+  if (tracker.UpdateAndGetCompletedSubmission() >= submission_index) {
+    return;
+  }
+  static bool reported = false;
+  if (!reported) {
+    reported = true;
+    REXLOG_ERROR(
+        "VulkanPresenter: waiting more than {} s for GPU submission {} ({}); the GPU work has not completed",
+        kStallReportNs / 1000000000ull, submission_index, where);
+  }
+  tracker.AwaitSubmissionCompletion(submission_index);
+}
