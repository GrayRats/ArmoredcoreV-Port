+thread_local Memory::PhysicalGpuWriteScope* Memory::PhysicalGpuWriteScope::active_ = nullptr;
+
+Memory::PhysicalGpuWriteScope::PhysicalGpuWriteScope(Memory& memory, uint32_t address, uint32_t length)
+    : memory_(memory), range_{address, length},
+      lock_(rex::thread::global_critical_region::mutex(), std::defer_lock) {
+  if (active_ || !range_.valid() || !memory_.physical_membase_) return;
+  lock_.lock();
+  if (memory_.heaps_.physical.QueryRangeAccess(address, address + length - 1) ==
+      rex::memory::PageAccess::kNoAccess) { Unlock(); return; }
+  if (memory_.physical_mutation_generations_.empty()) memory_.physical_mutation_generations_.resize(0x20000);
+  first_page_ = address >> 12;
+  const uint32_t end = uint32_t((uint64_t(address) + length + 4095) >> 12);
+  generations_.assign(memory_.physical_mutation_generations_.begin() + first_page_,
+                       memory_.physical_mutation_generations_.begin() + end);
+  if (!memory_.explicit_physical_readbacks_.WaitCpuAccess(lock_, range_)) { Unlock(); return; }
+  valid_ = true;
+  if (!ValidateLocked()) { Unlock(); return; }
+  memory_.explicit_gpu_coherence_enabled_.store(true, std::memory_order_release);
+  active_ = this;
+}
+
+Memory::PhysicalGpuWriteScope::~PhysicalGpuWriteScope() { Unlock(); }
+
+bool Memory::PhysicalGpuWriteScope::ValidateLocked() const {
+  return valid_ && lock_.owns_lock() && std::equal(generations_.begin(), generations_.end(),
+      memory_.physical_mutation_generations_.begin() + first_page_);
+}
+
+bool Memory::PhysicalGpuWriteScope::WaitForCpuAccess() {
+  return ValidateLocked() && memory_.explicit_physical_readbacks_.WaitCpuAccess(lock_, range_) &&
+      ValidateLocked();
+}
+
+void Memory::PhysicalGpuWriteScope::Unlock() {
+  if (active_ == this) active_ = nullptr;
+  valid_ = false;
+  if (lock_.owns_lock()) lock_.unlock();
+}
+
+bool Memory::SynchronizePhysicalCpuLocked(std::unique_lock<std::recursive_mutex>& lock,
+                                           uint32_t address, uint32_t length) {
+  if (!detail::PhysicalReadbackProviders::Range{address, length}.valid()) return false;
+  if (physical_mutation_generations_.empty()) physical_mutation_generations_.resize(0x20000);
+  const uint32_t first = address >> 12;
+  const uint32_t end = uint32_t((uint64_t(address) + length + 4095) >> 12);
+  const std::vector<uint64_t> snapshot(physical_mutation_generations_.begin() + first,
+                                      physical_mutation_generations_.begin() + end);
+  return SynchronizeExplicitPhysicalReadback(lock, address, length) &&
+      std::equal(snapshot.begin(), snapshot.end(), physical_mutation_generations_.begin() + first);
+}
+
+bool Memory::SynchronizePhysicalCpu(uint32_t address, uint32_t length) const {
+  address &= 0x1FFFFFFF;
+  if (!detail::PhysicalReadbackProviders::Range{address, length}.valid() || !physical_membase_) return false;
+  if (!explicit_gpu_coherence_enabled()) return true;
+  auto* self = const_cast<Memory*>(this);
+  auto* scope = PhysicalGpuWriteScope::active_;
+  if (scope && &scope->memory_ == this) {
+    return self->SynchronizePhysicalCpuLocked(scope->lock_, address, length);
+  }
+  auto lock = rex::thread::global_critical_region::AcquireDirect();
+  return self->SynchronizePhysicalCpuLocked(lock, address, length);
+}
+
+bool Memory::ReadPhysicalCpu(uint32_t address, void* destination, uint32_t length) const {
+  address &= 0x1FFFFFFF;
+  if (!length) return true;
+  if (!destination || !physical_membase_ ||
+      !detail::PhysicalReadbackProviders::Range{address, length}.valid()) return false;
+  if (!explicit_gpu_coherence_enabled()) {
+    std::memcpy(destination, TranslatePhysical(address), length); return true;
+  }
+  auto* self = const_cast<Memory*>(this);
+  auto copy = [&](std::unique_lock<std::recursive_mutex>& lock) {
+    const uint64_t pin = self->BeginPhysicalCpuAccess(lock, address, length);
+    if (!pin) return false;
+    std::memcpy(destination, TranslatePhysical(address), length);
+    return self->EndPhysicalCpuAccess(lock, pin);
+  };
+  auto* scope = PhysicalGpuWriteScope::active_;
+  if (scope && &scope->memory_ == this) return copy(scope->lock_);
+  auto lock = rex::thread::global_critical_region::AcquireDirect();
+  return copy(lock);
+}
+
+bool Memory::WritePhysicalCpu(uint32_t address, const void* source, uint32_t length) {
+  return WritePhysicalCpuImpl(address, source, length, true);
+}
+
+bool Memory::PublishPhysicalGpuReadback(uint32_t address, const void* source, uint32_t length) {
+  return WritePhysicalCpuImpl(address, source, length, false);
+}
+
+bool Memory::CollectPublishedPhysicalReadbacks() {
+  auto lock = rex::thread::global_critical_region::AcquireDirect();
+  return explicit_physical_readbacks_.CollectPublished(lock);
+}
+
+bool Memory::WritePhysicalCpuImpl(uint32_t address, const void* source, uint32_t length, bool notify) {
+  address &= 0x1FFFFFFF;
+  if (!length) return true;
+  if (!source || !physical_membase_ ||
+      !detail::PhysicalReadbackProviders::Range{address, length}.valid()) return false;
+  if (!explicit_gpu_coherence_enabled()) {
+    std::memcpy(TranslatePhysical(address), source, length); return true;
+  }
+  auto copy = [&](std::unique_lock<std::recursive_mutex>& lock) {
+    const uint64_t pin = BeginPhysicalCpuAccess(lock, address, length);
+    if (!pin) return false;
+    std::memcpy(TranslatePhysical(address), source, length);
+    return notify ? EndPhysicalCpuWriteAccess(lock, pin, address, length) : EndPhysicalCpuAccess(lock, pin);
+  };
+  auto* scope = PhysicalGpuWriteScope::active_;
+  if (scope && &scope->memory_ == this) return copy(scope->lock_);
+  auto lock = rex::thread::global_critical_region::AcquireDirect();
+  return copy(lock);
 }
 
