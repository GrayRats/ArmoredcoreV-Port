+// Caller owns the global memory lock. Host hardware bypasses guest alias
+// permissions, but it must still address committed physical allocation pages.
+bool Memory::PreparePhysicalCpuMappingLocked(uint32_t address, uint32_t length) {
+  std::lock_guard<std::recursive_mutex> heap_lock(heaps_.physical.heap_mutex_);
+  const uint32_t first = address >> 12;
+  const uint32_t end = uint32_t((uint64_t(address) + length + 4095) >> 12);
+  bool writable = true;
+  for (uint32_t i = first; i < end; ++i) {
+    const auto& page = heaps_.physical.page_table_[i];
+    if (!(page.state & kMemoryAllocationCommit)) return false;
+    if (!(page.current_protect & kMemoryProtectWrite)) writable = false;
+  }
+  if (writable) return true;
+  const uint32_t start = address & ~(system_page_size_ - 1);
+  const uint64_t limit = (uint64_t(address) + length + system_page_size_ - 1) &
+                         ~uint64_t(system_page_size_ - 1);
+  return rex::memory::Protect(TranslatePhysical(start), size_t(limit - start),
+                              rex::memory::PageAccess::kReadWrite);
 }
 
